{
  "name": "syntaxis-frontend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "vinext dev --port 5173",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --ip 127.0.0.1 --port 5173 --inspector-port 0",
    "typecheck": "tsc --noEmit",
    "test:core": "node --no-warnings --experimental-strip-types scripts/verify-core.mjs",
    "test:latex": "node --no-warnings --experimental-strip-types scripts/verify-latex.mjs",
    "test:routes": "node scripts/verify-routes.mjs",
    "test:browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@gsap/react": "2.1.2",
    "@shadcn/react": "0.3.0",
    "@siglum/engine": "0.1.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.31.0",
    "motion": "13.5.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "playwright": "1.55.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": { "miniflare": { "sharp": "0.35.4" } }
}
